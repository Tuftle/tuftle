{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/addons",
      "destination": "/wren/addons",
      "permanent": false
    },
    {
      "source": "/addons/:path*",
      "destination": "/wren/addons/:path*",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/mods/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=300"
        }
      ]
    },
    {
      "source": "/blog/admin",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        }
      ]
    },
    {
      "source": "/burrow/latest.json",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=300"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/blog",
      "destination": "/api/blog?view=index"
    },
    {
      "source": "/blog/feed.xml",
      "destination": "/api/blog?view=feed"
    },
    {
      "source": "/blog/tag/:tag",
      "destination": "/api/blog?view=tag&tag=:tag"
    },
    {
      "source": "/blog/:slug",
      "destination": "/api/blog?view=post&slug=:slug"
    }
  ]
}
